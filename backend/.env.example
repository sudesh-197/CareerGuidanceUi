# Copy to backend/.env and adjust. Everything is optional for local development.

# --- Security ---------------------------------------------------------------
# Secret used to sign login tokens. SET THIS before deploying anywhere public.
# (Changing it logs every user out.)
# SECRET_KEY=change-me-to-a-long-random-string

# --- Email (forgot password) ------------------------------------------------
# Gmail + 2FA + App Password: https://myaccount.google.com/apppasswords
# MAIL_USERNAME=your_gmail@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# Public URL of the React app (used inside the reset-password e-mail)
# FRONTEND_URL=http://localhost:3000

# --- Server -----------------------------------------------------------------
# FLASK_DEBUG=1            # dev only: Flask debugger + shows the reset link when e-mail is not configured
# FLASK_HOST=127.0.0.1     # use 0.0.0.0 to expose on your network
# PORT=5000
# DATABASE_URL=sqlite:///career_guidance.db
# CORS_ORIGINS=http://localhost:3000     # comma separated; default * (any origin)
# MAX_UPLOAD_MB=500
# EXPLORE_RATE_LIMIT=30 per minute       # optional throttle for /api/explore/*
# ALLOW_DEV_RESET_LINK=1   # return the reset link in the API response when e-mail is not configured (never in production)

# --- Local AI chatbot (optional) -------------------------------------------
# LM_STUDIO_URL=http://localhost:1234/v1
# MISTRAL_MODEL_PATH=models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
